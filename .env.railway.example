# Railway يضبط PORT تلقائياً. لا تضف قيمة له يدوياً.
NODE_ENV=production

# اربطها بخدمة MySQL داخل Railway:
# ${{MySQL.MYSQL_URL}}
DATABASE_URL=

# أنشئ قيمة عشوائية طويلة ولا تضعها في GitHub.
JWT_SECRET=

# مفتاح OpenRouteService إلزامي لحساب مسافة الطريق الحقيقية ومدة الرحلة.
# لا يستخدم التطبيق بديلاً تقريبياً أو Google Maps عند غياب الخدمة أو فشلها.
OPENROUTESERVICE_API_KEY=

# Prefer Base64 for Docker/Coolify/VibeNest deployments. It avoids quoting and
# multiline parsing problems when the platform injects environment variables.
# Generate locally with: base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# WAHA WhatsApp notifications (optional). Use a dedicated WhatsApp number.
WAHA_URL=http://your-waha-server:3000
WAHA_API_KEY=
WAHA_SESSION=default

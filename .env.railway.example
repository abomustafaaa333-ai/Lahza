# Railway يضبط PORT تلقائياً. لا تضف قيمة له يدوياً.
NODE_ENV=production

# اربطها بخدمة MySQL داخل Railway:
# ${{MySQL.MYSQL_URL}}
DATABASE_URL=

# أنشئ قيمة عشوائية طويلة ولا تضعها في GitHub.
JWT_SECRET=

# مفتاح OpenRouteService لحساب مسافة الطريق الحقيقية ومدة الرحلة.
# عند وجوده يستخدمه لحظة أولاً، ويمكن إبقاء Google كخيار احتياطي.
OPENROUTESERVICE_API_KEY=

# خيار احتياطي فقط: مفتاح Google Maps API مع تفعيل Directions API.
GOOGLE_MAPS_API_KEY=

# WAHA WhatsApp notifications (optional). Use a dedicated WhatsApp number.
WAHA_URL=http://your-waha-server:3000
WAHA_API_KEY=
WAHA_SESSION=default

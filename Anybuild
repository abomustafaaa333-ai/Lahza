# Lahza Wasmer Edge build definition
# Force the Node/Express provider rather than the static provider.

load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node dist/index.js",
    },
    node_package_manager = "npm",
    node_server = "express",
    node_version = "24",
    node_build_command = "npm run build",
)

build = node_build(config)

node_serve(config, build, name = "lahza")
